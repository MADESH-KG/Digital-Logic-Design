module async_dff_tb;

reg clk, reset, d;
wire q;

async_dff uut (
    .clk(clk),
    .reset(reset),
    .d(d),
    .q(q)
);

always #5 clk = ~clk;

initial begin
    clk = 0;
    reset = 0;
    d = 0;

    #7  d = 1;
    #8  d = 0;
    #3  reset = 1;
    #4  reset = 0;
    #8  d = 1;

    #20 $finish;
end

initial begin
    $monitor("Time=%0t clk=%b reset=%b d=%b q=%b",
              $time, clk, reset, d, q);
end

endmodule
